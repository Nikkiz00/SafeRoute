# Server
NODE_ENV=development
PORT=3000

# Database (MariaDB/MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/saferoute_dev"

# JWT Secrets — cambia in produzione con valori casuali
JWT_SECRET=your-secret-key-min-16-chars-change-in-prod
JWT_REFRESH_SECRET=your-refresh-secret-key-min-16-chars-change-in-prod

# Frontend URL (per link email e CORS)
FRONTEND_URL=http://localhost:5173

# Email SMTP (opzionale — se non configurato, le email vengono saltate)
# IMPORTANTE: per Gmail/Google Workspace, NON usare la password normale.
# Usa App Password: myaccount.google.com > Sicurezza > Password per le app
# Per Zoho Mail: Impostazioni > Sicurezza > Password specifiche per app
# Per Brevo (ex Sendinblue): usa SMTP_USER=apikey e SMTP_PASS=<API-key-SMTP>
# Verifica connessione in dev: GET http://localhost:3000/api/health/email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuaemail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password, NON la password normale
SMTP_FROM=SafeRoute <noreply@saferoute.app>

# SMS (opzionale — 'none' disabilita SMS, 'mock' simula, 'twilio' reale)
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Routing (OSRM)
# Nessuna API key richiesta per OSRM public demo (https://router.project-osrm.org)
# Per uso in produzione, configurare un'istanza OSRM self-hosted

# Geocoding (Nominatim)
# Nessuna API key richiesta per Nominatim (https://nominatim.openstreetmap.org)
# Per uso in produzione, rispettare il rate limiting (1 req/s) o usare istanza self-hosted
